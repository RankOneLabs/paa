{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paa.dev/payload-schemas/response-quality-llm.schema.json",
  "title": "response_quality evidence payload — LLM judge",
  "description": "Narrows paa-evidence-record for inbound_reply_surfacing's response_quality property as produced by the llm_judge/rubric/proxy evaluator.",
  "allOf": [
    { "$ref": "https://paa.dev/paa-evidence-record.schema.json" },
    {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "object",
          "properties": {
            "value": { "type": "string", "enum": ["approve", "revise", "reject"] }
          }
        },
        "payload": {
          "type": "object",
          "required": ["rubric_id", "score", "model"],
          "additionalProperties": false,
          "properties": {
            "rubric_id": { "type": "string", "minLength": 1 },
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "model": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  ]
}
